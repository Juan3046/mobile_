rules_version = '2';

// RM Games — Firestore security rules (docs/09 stream E). Deploy with the Firebase console
// (Firestore → Rules → paste) or `firebase deploy --only firestore:rules`.
// Everything not matched below is denied.
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() { return request.auth != null; }

    // Nick reservations: one document per lowercase nick, created once by its owner,
    // never updated or deleted (nicks are permanent — docs/03 §3.2).
    match /nicks/{key} {
      allow read: if signedIn();
      allow create: if signedIn()
        && request.resource.data.keys().hasOnly(['uid', 'nick', 'createdAt'])
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.nick is string
        && request.resource.data.nick.matches('^[A-Za-z0-9_]{3,12}$')
        && key == request.resource.data.nick.lower()
        && request.resource.data.createdAt == request.time;
      allow update, delete: if false;
    }

    // Player profile: only the owner writes it, only with a nick they reserved, and the
    // nick never changes afterwards.
    match /users/{uid} {
      allow read: if signedIn();
      allow create: if signedIn() && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(['nick'])
        && get(/databases/$(database)/documents/nicks/$(request.resource.data.nick.lower())).data.uid == uid;
      allow update: if signedIn() && request.auth.uid == uid
        && request.resource.data.nick == resource.data.nick;
      allow delete: if false;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
